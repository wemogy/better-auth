{
  "name": "@wemogy/better-auth-cosmos",
  "version": "0.0.1",
  "description": "A custom better-auth adapter that integrates with Azure Cosmos DB.",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc --w",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "prettier --check \"src/**/*.ts\" && eslint src/**/*.ts"
  },
  "dependencies": {
    "@azure/cosmos": "^4.7.0",
    "better-auth": "^1.3.33"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^4.0.4"
  },
  "keywords": [
    "better-auth",
    "cosmosdb",
    "adapter"
  ],
  "author": "wemogy IT",
  "license": "UNLICENSED"
}
