{
  "name": "@wemogy/better-auth-cosmos",
  "version": "0.0.1",
  "description": "A custom better-auth adapter that integrates with Azure Cosmos DB.",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc --w",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "prettier --check \"src/**/*.ts\" && eslint src/**/*.ts"
  },
  "dependencies": {
    "@azure/cosmos": "^4.7.0",
    "@wemogy/config": "^2.0.1",
    "better-auth": "^1.3.34"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "eslint-plugin-check-file": "^3.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-naming-convention": "^2.2.4",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "better-auth",
    "cosmosdb",
    "adapter"
  ],
  "author": "wemogy IT",
  "license": "UNLICENSED"
}
