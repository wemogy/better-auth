{
  "name": "@wemogy/better-auth-react",
  "version": "0.0.1",
  "description": "UI components and hooks for better-auth authentication.",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --w",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "check": "prettier --check \"src/**/*.{ts,tsx}\" && eslint src/**/*.ts src/**/*.tsx"
  },
  "dependencies": {
    "@wemogy/better-auth-cosmos": "workspace:*",
    "better-auth": "^1.3.34",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.38.0",
    "eslint-plugin-check-file": "^3.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-naming-convention": "^2.2.4",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3"
  },
  "keywords": [
    "better-auth",
    "cosmos",
    "ui",
    "react",
    "authentication"
  ],
  "author": "wemogy IT",
  "license": "UNLICENSED"
}
